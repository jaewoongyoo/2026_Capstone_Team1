FROM node:22-alpine AS build

WORKDIR /workspace
COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

ARG VITE_MCP_CHAT_URL=/api/mcp/chat
ARG VITE_WS_URL=/ws-stomp
ENV VITE_MCP_CHAT_URL=${VITE_MCP_CHAT_URL}
ENV VITE_WS_URL=${VITE_WS_URL}

RUN npm run build

FROM nginx:1.27-alpine

COPY deploy/onprem/nginx/default.conf /etc/nginx/conf.d/default.conf
COPY --from=build /workspace/dist /usr/share/nginx/html

EXPOSE 80
