# =============================================================================
# Capstone Dashboard On-Premise Environment
# =============================================================================

# Public access
FRONTEND_PORT=80

# Database
POSTGRES_DB=dashboard
POSTGRES_USER=dashboard
POSTGRES_PASSWORD=change-this-postgres-password

# Backend
JWT_SECRET=change-this-to-a-very-long-random-secret-at-least-64-characters-for-hs512-signing
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*,http://*:80,http://*:8080

# Redis
REDIS_PORT=6379

# MQTT
MQTT_PORT=1883
MQTT_WS_PORT=9001
MQTT_USERNAME=
MQTT_PASSWORD=

# Edge Gateway TCP ports
EDGE_GATEWAY_CVD_PORT=5000
EDGE_GATEWAY_ETCHER_PORT=5001

# MCP
MCP_HTTP_PORT=3333
MCP_HTTP_CORS_ORIGIN=*

# Frontend build-time defaults
# Keep these relative for on-premise single-origin access through nginx.
VITE_MCP_CHAT_URL=/api/mcp/chat
VITE_WS_URL=/ws-stomp
